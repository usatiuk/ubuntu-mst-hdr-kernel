#!/usr/bin/env bash
set -Eeuo pipefail

TOOL_VERSION="0.2.0"
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
WORK_ROOT="${ROOT_DIR}/.work"
SOURCE_CACHE_ROOT="${WORK_ROOT}/source-cache"
CURRENT_DIR="${WORK_ROOT}/current"
DOWNLOAD_DIR="${CURRENT_DIR}/download"
SOURCE_DIR="${CURRENT_DIR}/source"
META_DIR="${CURRENT_DIR}/meta"
MANIFEST="${CURRENT_DIR}/manifest.env"
DIST_ROOT="${ROOT_DIR}/dist"
PATCH_FILE="${ROOT_DIR}/patches/intel-mst-vrr-hdr-v6-ubuntu-7.0.patch"
PATCH_SHA256_EXPECTED="8a8b9b40462337acfba9c4903b52c098757eb71a5e99fdaaa9afd9cf574056db"
BUILDER_IMAGE="${MST_HDR_BUILDER_IMAGE:-mst-hdr-kernel-builder:ubuntu-26.04}"
TARGET_SUITE="resolute"

note() {
    printf '==> %s\n' "$*"
}

warn() {
    printf 'warning: %s\n' "$*" >&2
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

need_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

safe_reset_dir() {
    local target="$1"

    case "$target" in
        "${WORK_ROOT}/"*|"${DIST_ROOT}/"*) ;;
        *) die "refusing to reset unsafe path: $target" ;;
    esac

    rm -rf -- "$target"
    mkdir -p -- "$target"
}

validate_version_token() {
    local value="$1"
    [[ "$value" =~ ^[0-9A-Za-z.+:~_-]+$ ]] ||
        die "unsafe or unsupported version token: $value"
}

validate_revision() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]] ||
        die "packaging revision must be a positive integer"
}

patch_sha256() {
    sha256sum "$PATCH_FILE" | awk '{print $1}'
}

verify_patch() {
    local actual expected_paths actual_paths

    [[ -f "$PATCH_FILE" ]] || die "missing backport: $PATCH_FILE"
    actual="$(patch_sha256)"
    [[ "$actual" == "$PATCH_SHA256_EXPECTED" ]] ||
        die "backport checksum mismatch: expected $PATCH_SHA256_EXPECTED, got $actual"

    expected_paths=$'drivers/gpu/drm/display/drm_dp_mst_topology.c\n'
    expected_paths+=$'drivers/gpu/drm/i915/display/intel_ddi.c\n'
    expected_paths+=$'drivers/gpu/drm/i915/display/intel_display_types.h\n'
    expected_paths+=$'drivers/gpu/drm/i915/display/intel_dp.c\n'
    expected_paths+=$'drivers/gpu/drm/i915/display/intel_dp.h\n'
    expected_paths+=$'drivers/gpu/drm/i915/display/intel_dp_mst.c\n'
    expected_paths+='drivers/gpu/drm/i915/display/intel_vrr.c'
    actual_paths="$(
        sed -n 's#^+++ b/##p' "$PATCH_FILE" |
            sort -u
    )"
    [[ "$actual_paths" == "$expected_paths" ]] ||
        die "backport changes paths outside the reviewed DRM display set"
}

derive_versions() {
    local source_version="$1"
    local packaging_revision="$2"
    local no_epoch base ubuntu_tail upload

    validate_version_token "$source_version"
    validate_revision "$packaging_revision"

    no_epoch="${source_version#*:}"
    [[ "$no_epoch" == *-*.* ]] ||
        die "unsupported Ubuntu kernel source version: $source_version"

    base="${no_epoch%%-*}"
    ubuntu_tail="${no_epoch#*-}"
    upload="${ubuntu_tail#*.}"
    [[ -n "$base" && -n "$upload" && "$upload" != "$ubuntu_tail" ]] ||
        die "could not derive base/upload from: $source_version"

    CUSTOM_VERSION="${base}-999.${upload}+msthdr${packaging_revision}"
    KERNEL_RELEASE="${base}-999-generic"
    META_VERSION="${base}.999.${upload}+msthdr${packaging_revision}"
}

resolve_running_source() {
    local running package_version built_using installed_manifest

    running="$(uname -r)"
    if [[ "$running" == *-999-generic ]]; then
        installed_manifest="/usr/share/linux-mst-hdr/mst-hdr-build-manifest"
        if [[ -r "$installed_manifest" ]]; then
            # The file is generated by this tool and installed read-only by dpkg.
            # shellcheck disable=SC1090
            source "$installed_manifest"
            printf '%s\n' "$UBUNTU_SOURCE_VERSION"
            return
        fi
        if [[ -r "$MANIFEST" ]]; then
            # shellcheck disable=SC1090
            source "$MANIFEST"
            printf '%s\n' "$UBUNTU_SOURCE_VERSION"
            return
        fi
        die "running custom ABI has no installed or local build manifest; use --latest or --source-version"
    fi

    built_using="$(
        apt-cache show "linux-image-${running}" 2>/dev/null |
            sed -n 's/^Built-Using:.*linux (= \([^)]*\)).*/\1/p' |
            head -n 1
    )"
    if [[ -n "$built_using" ]]; then
        printf '%s\n' "$built_using"
        return
    fi

    package_version="$(
        dpkg-query -W -f='${Version}' "linux-modules-${running}" 2>/dev/null || true
    )"
    [[ -n "$package_version" ]] ||
        die "cannot resolve Ubuntu source version for running kernel $running"
    printf '%s\n' "$package_version"
}

resolve_latest_source() {
    local candidate

    require_image >&2
    candidate="$(
        docker run --rm "$BUILDER_IMAGE" bash -Eeuo pipefail -c '
            apt-get update >&2
            apt-cache policy linux-source |
                awk "/Candidate:/ { print \$2; exit }"
        '
    )"
    [[ -n "$candidate" && "$candidate" != "(none)" ]] ||
        die "cannot resolve the current linux-source candidate"
    printf '%s\n' "$candidate"
}

docker_run() {
    local -a user_options

    need_command docker
    user_options=()
    if ! docker_is_rootless; then
        user_options=(--user "$(id -u):$(id -g)")
    fi
    docker run --rm \
        "${user_options[@]}" \
        --env HOME=/tmp/mst-hdr-home \
        --volume "${ROOT_DIR}:/workspace" \
        --workdir /workspace \
        "$BUILDER_IMAGE" "$@"
}

docker_is_rootless() {
    docker info --format '{{json .SecurityOptions}}' 2>/dev/null |
        grep -q '"name=rootless"'
}

build_image() {
    local refresh="${1:-false}"
    local -a options

    need_command docker
    options=(--tag "$BUILDER_IMAGE")
    if [[ "$refresh" == true ]]; then
        options=(--pull --no-cache "${options[@]}")
    elif docker image inspect "$BUILDER_IMAGE" >/dev/null 2>&1; then
        note "Builder image already exists: $BUILDER_IMAGE"
        return
    fi

    note "Building Ubuntu 26.04 kernel builder image"
    BUILDX_CONFIG="${WORK_ROOT}/buildx" \
        docker build "${options[@]}" "${ROOT_DIR}/container"
}

require_image() {
    if ! docker image inspect "$BUILDER_IMAGE" >/dev/null 2>&1; then
        build_image false
    fi
}

load_manifest() {
    [[ -r "$MANIFEST" ]] ||
        die "no prepared source; run './mst-hdr-kernel prepare' first"
    # This manifest is generated locally by write_manifest().
    # shellcheck disable=SC1090
    source "$MANIFEST"
}

write_manifest() {
    local prepared_at patch_hash

    prepared_at="$(date --utc '+%Y-%m-%dT%H:%M:%SZ')"
    patch_hash="$(patch_sha256)"
    {
        printf 'UBUNTU_SOURCE_VERSION=%q\n' "$UBUNTU_SOURCE_VERSION"
        printf 'CUSTOM_VERSION=%q\n' "$CUSTOM_VERSION"
        printf 'KERNEL_RELEASE=%q\n' "$KERNEL_RELEASE"
        printf 'META_VERSION=%q\n' "$META_VERSION"
        printf 'PACKAGING_REVISION=%q\n' "$PACKAGING_REVISION"
        printf 'TARGET_SUITE=%q\n' "$TARGET_SUITE"
        printf 'PATCH_SHA256=%q\n' "$patch_hash"
        printf 'PATCH_MESSAGE_ID=%q\n' "20260902051206.264215-1-xiaolu.xie@intel.com"
        printf 'COLORIMETRY_MESSAGE_ID=%q\n' "20260626214513.179943-2-gildekel@google.com"
        printf 'EXTERNAL_ZFS_MODULES=%q\n' "omitted"
        printf 'PREPARED_AT=%q\n' "$prepared_at"
    } >"$MANIFEST"
}

sed_escape() {
    printf '%s' "$1" | sed 's/[&|\\]/\\&/g'
}

prepare_meta() {
    local full_name email rfc_date
    local esc_name esc_email esc_date esc_meta esc_release esc_custom

    full_name="${DEBFULLNAME:-MST HDR Kernel Builder}"
    email="${DEBEMAIL:-mst-hdr-kernel@localhost}"
    rfc_date="$(date -R)"

    safe_reset_dir "$META_DIR"
    cp -a "${ROOT_DIR}/meta/." "$META_DIR/"
    cp "$MANIFEST" "${META_DIR}/mst-hdr-build-manifest"

    esc_name="$(sed_escape "$full_name")"
    esc_email="$(sed_escape "$email")"
    esc_date="$(sed_escape "$rfc_date")"
    esc_meta="$(sed_escape "$META_VERSION")"
    esc_release="$(sed_escape "$KERNEL_RELEASE")"
    esc_custom="$(sed_escape "$CUSTOM_VERSION")"

    sed \
        -e "s|@META_VERSION@|${esc_meta}|g" \
        -e "s|@KERNEL_RELEASE@|${esc_release}|g" \
        -e "s|@DEBFULLNAME@|${esc_name}|g" \
        -e "s|@DEBEMAIL@|${esc_email}|g" \
        -e "s|@RFC2822_DATE@|${esc_date}|g" \
        "${META_DIR}/debian/changelog.in" \
        >"${META_DIR}/debian/changelog"
    sed \
        -e "s|@KERNEL_RELEASE@|${esc_release}|g" \
        -e "s|@CUSTOM_VERSION@|${esc_custom}|g" \
        -e "s|@DEBFULLNAME@|${esc_name}|g" \
        -e "s|@DEBEMAIL@|${esc_email}|g" \
        "${META_DIR}/debian/control.in" \
        >"${META_DIR}/debian/control"
    rm -- "${META_DIR}/debian/changelog.in" "${META_DIR}/debian/control.in"
    chmod +x "${META_DIR}/debian/rules"
}

link_original_tarballs() {
    local original base

    shopt -s nullglob
    for original in "${DOWNLOAD_DIR}"/linux_*.orig.tar.*; do
        base="${original##*/}"
        if [[ -e "${CURRENT_DIR}/${base}" ]]; then
            cmp -s "$original" "${CURRENT_DIR}/${base}" ||
                die "conflicting original tarball: ${CURRENT_DIR}/${base}"
        else
            ln -s "download/${base}" "${CURRENT_DIR}/${base}"
        fi
    done
    shopt -u nullglob
}

source_cache_key() {
    printf '%s\n' "${1//:/_}"
}

source_cache_is_valid() {
    local cache_dir="$1"

    [[ -f "${cache_dir}/.complete" && -f "${cache_dir}/SHA256SUMS" ]] ||
        return 1
    (
        cd "$cache_dir"
        sha256sum --check --quiet SHA256SUMS
    )
}

populate_source_cache() {
    local source_version="$1"
    local refresh="$2"
    local cache_key cache_dir cached_file
    local docker_rootless
    local -a cached_files

    cache_key="$(source_cache_key "$source_version")"
    cache_dir="${SOURCE_CACHE_ROOT}/${cache_key}"

    if [[ "$refresh" != true ]] && source_cache_is_valid "$cache_dir"; then
        note "Reusing cached Ubuntu source package: $source_version"
    else
        safe_reset_dir "$cache_dir"
        if docker_is_rootless; then
            docker_rootless=true
        else
            docker_rootless=false
        fi
        note "Downloading Ubuntu source package into versioned cache"
        docker run --rm \
            --env HOME=/tmp/mst-hdr-home \
            --env TARGET_SOURCE_VERSION="$source_version" \
            --env CACHE_PATH="/workspace/.work/source-cache/${cache_key}" \
            --env HOST_UID="$(id -u)" \
            --env HOST_GID="$(id -g)" \
            --env DOCKER_ROOTLESS="$docker_rootless" \
            --volume "${ROOT_DIR}:/workspace" \
            --workdir /workspace \
            "$BUILDER_IMAGE" \
            bash -Eeuo pipefail -c '
                apt-get update
                cd "$CACHE_PATH"
                apt-get -o APT::Sandbox::User=root source \
                    --download-only "linux=${TARGET_SOURCE_VERSION}"
                dsc_files=(linux_*.dsc)
                if ((${#dsc_files[@]} != 1)); then
                    printf "expected one linux dsc, found %d\n" "${#dsc_files[@]}" >&2
                    exit 1
                fi
                if [[ "$DOCKER_ROOTLESS" != true ]]; then
                    chown "$HOST_UID:$HOST_GID" linux_*
                fi
            '
        (
            cd "$cache_dir"
            find . -maxdepth 1 -type f -name 'linux_*' -print0 |
                sort -z |
                xargs -0 sha256sum >SHA256SUMS
        )
        : >"${cache_dir}/.complete"
    fi

    mapfile -d '' cached_files < <(
        find "$cache_dir" -maxdepth 1 -type f -name 'linux_*' -print0 |
            sort -z
    )
    ((${#cached_files[@]} >= 3)) ||
        die "source cache is incomplete: $cache_dir"
    for cached_file in "${cached_files[@]}"; do
        ln "$cached_file" "${DOWNLOAD_DIR}/${cached_file##*/}"
    done
}

unpack_cached_source() {
    # Expansion is intentionally deferred to the shell inside the container.
    # shellcheck disable=SC2016
    docker_run bash -Eeuo pipefail -c '
        cd /workspace/.work/current/download
        dsc_files=(linux_*.dsc)
        if ((${#dsc_files[@]} != 1)); then
            printf "expected one cached linux dsc, found %d\n" "${#dsc_files[@]}" >&2
            exit 1
        fi
        if ! dpkg-source -x "${dsc_files[0]}" ../source \
            >../unpack.log 2>&1; then
            tail -n 200 ../unpack.log >&2
            exit 1
        fi
    '
}

apply_backport() {
    local reverse_result

    verify_patch
    note "Checking backport with fuzz disabled"
    if patch --directory "$SOURCE_DIR" --strip=1 --fuzz=0 --dry-run \
        <"$PATCH_FILE" >/dev/null; then
        patch --directory "$SOURCE_DIR" --strip=1 --fuzz=0 <"$PATCH_FILE"
        return
    fi

    reverse_result=0
    patch --directory "$SOURCE_DIR" --strip=1 --fuzz=0 --reverse --dry-run \
        <"$PATCH_FILE" >/dev/null 2>&1 || reverse_result=$?
    if [[ "$reverse_result" -eq 0 ]]; then
        die "backport appears to be present already; inspect whether Ubuntu has upstreamed MST-HDR"
    fi
    die "backport does not apply cleanly; the Ubuntu update requires manual review"
}

omit_external_zfs_dependency() {
    local vars_file="${SOURCE_DIR}/debian.master/control.d/vars.generic"
    local expected

    expected='depends="linux-main-modules-zfs-PKGVER-ABINUM-generic [amd64 arm64 ppc64el s390x]"'
    [[ -f "$vars_file" ]] || die "missing Ubuntu generic packaging variables"
    grep -Fqx "$expected" "$vars_file" ||
        die "Ubuntu generic ZFS dependency changed; review before building"
    sed -i \
        '\|^depends="linux-main-modules-zfs-PKGVER-ABINUM-generic \[amd64 arm64 ppc64el s390x\]"$|c\depends=""' \
        "$vars_file"
    note "Omitting unavailable Canonical-signed ZFS companion modules"
}

prepare_source() {
    local mode="running"
    local explicit_version=""
    local revision="2"
    local refresh_source="false"
    local full_name email

    while (($#)); do
        case "$1" in
            --running) mode="running" ;;
            --latest) mode="latest" ;;
            --source-version)
                shift
                (($#)) || die "--source-version requires a value"
                mode="explicit"
                explicit_version="$1"
                ;;
            --revision)
                shift
                (($#)) || die "--revision requires a value"
                revision="$1"
                ;;
            --refresh-source) refresh_source="true" ;;
            *) die "unknown prepare option: $1" ;;
        esac
        shift
    done

    case "$mode" in
        running) UBUNTU_SOURCE_VERSION="$(resolve_running_source)" ;;
        latest) UBUNTU_SOURCE_VERSION="$(resolve_latest_source)" ;;
        explicit) UBUNTU_SOURCE_VERSION="$explicit_version" ;;
        *) die "internal target mode error" ;;
    esac
    validate_version_token "$UBUNTU_SOURCE_VERSION"
    validate_revision "$revision"
    PACKAGING_REVISION="$revision"
    derive_versions "$UBUNTU_SOURCE_VERSION" "$PACKAGING_REVISION"

    note "Ubuntu source: $UBUNTU_SOURCE_VERSION"
    note "Custom version: $CUSTOM_VERSION"
    note "Kernel release: $KERNEL_RELEASE"

    need_command patch
    need_command sha256sum
    safe_reset_dir "$CURRENT_DIR"
    mkdir -p "$DOWNLOAD_DIR"
    require_image

    populate_source_cache "$UBUNTU_SOURCE_VERSION" "$refresh_source"
    note "Unpacking a fresh Ubuntu source tree from the cache"
    unpack_cached_source

    link_original_tarballs
    apply_backport
    omit_external_zfs_dependency

    full_name="${DEBFULLNAME:-MST HDR Kernel Builder}"
    email="${DEBEMAIL:-mst-hdr-kernel@localhost}"
    note "Adding custom Ubuntu changelog entry"
    # Variables are intentionally expanded inside the container.
    # shellcheck disable=SC2016
    docker_run \
        env \
        CUSTOM_VERSION="$CUSTOM_VERSION" \
        TARGET_SUITE="$TARGET_SUITE" \
        DEBFULLNAME="$full_name" \
        DEBEMAIL="$email" \
        bash -Eeuo pipefail -c '
            cd /workspace/.work/current/source
            dch --changelog debian.master/changelog \
                --newversion "$CUSTOM_VERSION" \
                --distribution "$TARGET_SUITE" \
                --force-distribution \
                "Rebase Intel MST VRR/HDR v6 with 10-bpc and per-connector colorimetry; omit unavailable Canonical-signed ZFS companion modules."
            cp debian.master/changelog debian/changelog
        '

    write_manifest
    prepare_meta
    note "Prepared source and meta-package under ${CURRENT_DIR}"
}

collect_local_artifacts() {
    local destination="${DIST_ROOT}/${CUSTOM_VERSION}/local"
    local -a packages

    safe_reset_dir "$destination"
    mapfile -d '' packages < <(
        find "$CURRENT_DIR" -maxdepth 1 -type f -name '*.deb' -print0 |
            sort -z
    )
    ((${#packages[@]})) || die "build completed without .deb artifacts"
    cp -- "${packages[@]}" "$destination/"
    (
        cd "$destination"
        sha256sum ./*.deb >SHA256SUMS
    )
    cp "$MANIFEST" "$destination/build-manifest.env"
    note "Local packages: $destination"
}

build_local() {
    local use_fakeroot=true

    load_manifest
    require_image
    if docker_is_rootless; then
        use_fakeroot=false
    fi
    note "Building the complete Ubuntu kernel; this can take a long time"
    # Variables are intentionally expanded inside the container.
    # shellcheck disable=SC2016
    docker_run env USE_FAKEROOT="$use_fakeroot" bash -Eeuo pipefail -c '
        run_kernel_rules() {
            if [[ "$USE_FAKEROOT" == true ]]; then
                fakeroot debian/rules "$@"
            else
                debian/rules "$@"
            fi
        }
        if ! {
            cd /workspace/.work/current/source &&
            run_kernel_rules clean &&
            run_kernel_rules binary &&
            cd /workspace/.work/current/meta &&
            dpkg-buildpackage -b -us -uc
        } >/workspace/.work/current/build-local.log 2>&1; then
            tail -n 200 /workspace/.work/current/build-local.log >&2
            exit 1
        fi
    '
    collect_local_artifacts
}

sign_source_changes() {
    local key="$1"
    local -a changes

    if [[ -z "$key" ]]; then
        return 0
    fi
    need_command debsign
    mapfile -d '' changes < <(
        find "$CURRENT_DIR" -maxdepth 1 -type f -name '*_source.changes' -print0 |
            sort -z
    )
    ((${#changes[@]} == 2)) ||
        die "expected kernel and meta source changes files before signing"
    for change in "${changes[@]}"; do
        debsign -k"$key" "$change"
    done
}

verify_source_roundtrip() {
    local roundtrip="${CURRENT_DIR}/roundtrip"
    local -a dscs

    safe_reset_dir "$roundtrip"
    mapfile -d '' dscs < <(
        find "$CURRENT_DIR" -maxdepth 1 -type f -name '*.dsc' -print0 |
            sort -z
    )
    ((${#dscs[@]} == 2)) || die "expected two source .dsc files"

    # Globs and arrays are intentionally evaluated inside the container.
    # shellcheck disable=SC2016
    docker_run bash -Eeuo pipefail -c '
        cd /workspace/.work/current
        rm -rf -- roundtrip/kernel roundtrip/meta
        kernel_dsc=(linux_*.dsc)
        meta_dsc=(linux-mst-hdr-meta_*.dsc)
        ((${#kernel_dsc[@]} == 1 && ${#meta_dsc[@]} == 1))
        if ! {
            dpkg-source -x "${kernel_dsc[0]}" roundtrip/kernel &&
            dpkg-source -x "${meta_dsc[0]}" roundtrip/meta
        } >roundtrip.log 2>&1; then
            tail -n 200 roundtrip.log >&2
            exit 1
        fi
        test -f roundtrip/kernel/debian.master/changelog
        test -f roundtrip/meta/debian/control
    '
}

collect_source_artifacts() {
    local destination="${DIST_ROOT}/${CUSTOM_VERSION}/source"
    local -a files

    safe_reset_dir "$destination"
    mapfile -d '' files < <(
        find "$CURRENT_DIR" -maxdepth 1 -type f \
            \( -name '*.dsc' -o -name '*_source.changes' \
               -o -name '*.diff.gz' -o -name '*.debian.tar.*' \
               -o -name '*.tar.xz' -o -name '*_source.buildinfo' \) \
            -print0 |
            sort -z
    )
    ((${#files[@]})) || die "source build completed without upload artifacts"
    cp -- "${files[@]}" "$destination/"
    (
        cd "$destination"
        sha256sum ./* >SHA256SUMS
    )
    cp "$MANIFEST" "$destination/build-manifest.env"
    note "PPA-ready source artifacts: $destination"
}

build_source() {
    local sign_key=""

    while (($#)); do
        case "$1" in
            --sign-key)
                shift
                (($#)) || die "--sign-key requires a value"
                sign_key="$1"
                ;;
            *) die "unknown build-source option: $1" ;;
        esac
        shift
    done

    load_manifest
    require_image
    note "Building kernel and meta source packages"
    docker_run bash -Eeuo pipefail -c '
        if ! {
            cd /workspace/.work/current/source &&
            dpkg-buildpackage -S -sd -us -uc &&
            cd /workspace/.work/current/meta &&
            dpkg-buildpackage -S -us -uc
        } >/workspace/.work/current/build-source.log 2>&1; then
            tail -n 200 /workspace/.work/current/build-source.log >&2
            exit 1
        fi
    '
    verify_source_roundtrip
    sign_source_changes "$sign_key"
    collect_source_artifacts
}

find_one_package() {
    local directory="$1"
    local pattern="$2"
    local -a matches

    mapfile -d '' matches < <(
        find "$directory" -maxdepth 1 -type f -name "$pattern" -print0
    )
    ((${#matches[@]} == 1)) ||
        die "expected one package matching $pattern, found ${#matches[@]}"
    printf '%s\n' "${matches[0]}"
}

secure_boot_is_disabled() {
    need_command mokutil
    mokutil --sb-state 2>/dev/null | grep -qi 'disabled'
}

install_packages() {
    local directory
    local base_release pattern package
    local -a packages

    load_manifest
    directory="${DIST_ROOT}/${CUSTOM_VERSION}/local"
    [[ -d "$directory" ]] || die "local build not found: $directory"
    secure_boot_is_disabled ||
        die "Secure Boot is enabled or indeterminate; disable it before installing this unsigned kernel"
    need_command findmnt
    if findmnt --raw --noheadings --types zfs 2>/dev/null | grep . >/dev/null ||
        lsmod 2>/dev/null | grep '^zfs ' >/dev/null; then
        die "ZFS is active; this custom ABI intentionally omits Canonical-signed ZFS modules"
    fi
    base_release="${KERNEL_RELEASE%-generic}"
    packages=()
    for pattern in \
        "linux-headers-${base_release}_*.deb" \
        "linux-headers-${KERNEL_RELEASE}_*.deb" \
        "linux-image-unsigned-${KERNEL_RELEASE}_*.deb" \
        "linux-modules-${KERNEL_RELEASE}_*.deb" \
        "linux-mst-hdr_*.deb"; do
        package="$(find_one_package "$directory" "$pattern")"
        packages+=("$package")
    done

    note "Installing custom ABI packages; GRUB configuration is left to package triggers"
    sudo apt-get install -- "${packages[@]}"
    note "Installed $KERNEL_RELEASE. Reboot manually when ready."
}

find_dell_connector() {
    local connector

    for connector in /sys/class/drm/card*-*; do
        [[ -r "${connector}/edid" ]] || continue
        if strings "${connector}/edid" | grep -q 'DELL U2725QE'; then
            printf '%s\n' "${connector##*/}"
            return
        fi
    done
    return 1
}

verify_running() {
    local running connector driver
    local log_matches

    running="$(uname -r)"
    [[ "$running" == *-999-generic ]] ||
        die "not running the custom ABI: $running"
    driver="$(
        lspci -nnk |
            awk '/VGA compatible controller|Display controller/ { in_gpu=1 }
                 in_gpu && /Kernel driver in use:/ { print $5; exit }'
    )"
    [[ "$driver" == i915 ]] || die "expected active i915 driver, found: ${driver:-unknown}"

    connector="$(find_dell_connector || true)"
    [[ -n "$connector" ]] ||
        die "Dell U2725QE EDID was not found on a DRM connector"
    if [[ ! -r "/sys/class/drm/${connector}/status" ]] ||
        ! grep -qx connected "/sys/class/drm/${connector}/status"; then
        die "$connector is not connected"
    fi

    note "Running custom kernel: $running"
    note "Active driver: i915"
    note "Dell HDR target: $connector"

    if command -v drm_info >/dev/null 2>&1; then
        if drm_info 2>/dev/null |
            grep -A120 -F "$connector" |
            grep -Eq 'HDR_OUTPUT_METADATA|HDR output metadata'; then
            note "DRM reports an HDR metadata property for $connector"
        else
            warn "could not confirm HDR metadata property in drm_info output"
        fi
    else
        warn "install drm-info to inspect connector HDR/Colorspace properties"
    fi

    log_matches="$(
        journalctl -k -b --no-pager 2>/dev/null |
            grep -Ei 'i915.*(BUG|Oops|unresolved|atomic.*fail)|drm.*(BUG|Oops)' ||
            true
    )"
    if [[ -n "$log_matches" ]]; then
        warn "suspicious i915/DRM messages found in this boot:"
        printf '%s\n' "$log_matches" >&2
        return 1
    fi

    printf '\nManual acceptance checks:\n'
    printf '  1. Enable HDR for the Dell U2725QE in GNOME Settings.\n'
    printf '  2. Toggle HDR off and on again to exercise the fastset path.\n'
    printf '  3. Confirm both displays retain their native modes.\n'
    printf '  4. Test dock hotplug and suspend/resume.\n'
}

remove_packages() {
    local package version status package_list
    local -a installed

    package_list="$(dpkg-query -W -f='${Package}\t${Version}\t${db:Status-Status}\n')"
    installed=()
    while IFS=$'\t' read -r package version status; do
        [[ "$status" != not-installed && "$version" =~ \+msthdr[0-9]+$ ]] || continue
        case "$package" in
            linux-mst-hdr|linux-image-unsigned-*-999-generic|linux-modules-*-999-generic|linux-headers-*-999|linux-headers-*-999-generic)
                installed+=("$package")
                ;;
        esac
    done <<<"$package_list"
    if ((${#installed[@]} == 0)); then
        note "No MST-HDR packages remain"
        return
    fi
    note "Purging custom packages; stock Ubuntu kernels are untouched"
    sudo apt-get purge -- "${installed[@]}"
}

doctor() {
    local driver sb_state

    printf 'tool_version=%s\n' "$TOOL_VERSION"
    printf 'os=%s\n' "$(
        # shellcheck disable=SC1091
        . /etc/os-release
        printf '%s %s' "$ID" "$VERSION_ID"
    )"
    printf 'kernel=%s\n' "$(uname -r)"
    driver="$(
        lspci -nnk 2>/dev/null |
            awk '/VGA compatible controller|Display controller/ { in_gpu=1 }
                 in_gpu && /Kernel driver in use:/ { print $5; exit }'
    )"
    printf 'display_driver=%s\n' "${driver:-unknown}"
    if command -v mokutil >/dev/null 2>&1; then
        sb_state="$(mokutil --sb-state 2>/dev/null | head -n 1 || true)"
    else
        sb_state="mokutil missing"
    fi
    printf 'secure_boot=%s\n' "$sb_state"
    if command -v docker >/dev/null 2>&1; then
        printf 'docker=%s\n' "$(docker version --format '{{.Client.Version}}' 2>/dev/null || printf unavailable)"
    else
        printf 'docker=missing\n'
    fi
    printf 'workspace_free=%s\n' "$(df -hP "$ROOT_DIR" | awk 'NR == 2 { print $4 }')"
    printf 'boot_free=%s\n' "$(df -hP /boot | awk 'NR == 2 { print $4 }')"
}

self_test() {
    local saved_custom saved_release saved_meta

    verify_patch
    derive_versions "7.0.0-28.28" 1
    saved_custom="$CUSTOM_VERSION"
    saved_release="$KERNEL_RELEASE"
    saved_meta="$META_VERSION"
    [[ "$saved_custom" == "7.0.0-999.28+msthdr1" ]]
    [[ "$saved_release" == "7.0.0-999-generic" ]]
    [[ "$saved_meta" == "7.0.0.999.28+msthdr1" ]]
    derive_versions "1:7.1.0-31.32.1" 2
    [[ "$CUSTOM_VERSION" == "7.1.0-999.32.1+msthdr2" ]]
    [[ "$KERNEL_RELEASE" == "7.1.0-999-generic" ]]
    note "Self-test passed"
}

usage() {
    cat <<'EOF'
Usage:
  ./mst-hdr-kernel doctor
  ./mst-hdr-kernel image [--refresh]
  ./mst-hdr-kernel prepare [--running | --latest | --source-version VERSION] [--revision N] [--refresh-source]
  ./mst-hdr-kernel build-local
  ./mst-hdr-kernel build-source [--sign-key KEY_ID]
  ./mst-hdr-kernel install
  ./mst-hdr-kernel verify
  ./mst-hdr-kernel remove
  ./mst-hdr-kernel self-test
  ./mst-hdr-kernel version
EOF
}

main() {
    local command="${1:-}"
    (($#)) && shift

    case "$command" in
        doctor) (($# == 0)) || die "doctor takes no arguments"; doctor ;;
        image)
            if (($# == 0)); then
                build_image false
            elif (($# == 1)) && [[ "$1" == --refresh ]]; then
                build_image true
            else
                die "usage: ./mst-hdr-kernel image [--refresh]"
            fi
            ;;
        prepare) prepare_source "$@" ;;
        build-local) (($# == 0)) || die "build-local takes no arguments"; build_local ;;
        build-source) build_source "$@" ;;
        install) (($# == 0)) || die "install takes no arguments"; install_packages ;;
        verify) (($# == 0)) || die "verify takes no arguments"; verify_running ;;
        remove) (($# == 0)) || die "remove takes no arguments"; remove_packages ;;
        self-test) (($# == 0)) || die "self-test takes no arguments"; self_test ;;
        version) (($# == 0)) || die "version takes no arguments"; printf '%s\n' "$TOOL_VERSION" ;;
        -h|--help|help) usage ;;
        "") usage; exit 1 ;;
        *) die "unknown command: $command" ;;
    esac
}

main "$@"
